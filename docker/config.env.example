# Kopeeri see fail nimele docker/config.env. Ära lisa config.env faili git'i.

# local = salvestused Dockeri volume'is; r2 = Cloudflare R2-s
STORAGE=local
LOCAL_DIR=/recordings

# Kohalik veebileht
WEB_PORT=8788
WEB_USER=raadio
# Parool on soovitatav; ilma selleta pääseb lehele igaüks samas võrgus.
# Ära pane päris parooli reposse ega vestlusesse.
WEB_PASS=
# Soovitatav podcasti-feedi kopeerimiseks localhost-ist. Kasuta hosti LAN- või Tailscale'i aadressi.
# WEB_URL=http://192.168.1.50:8788

# Dockeri image'it uuendatakse `docker compose build --pull` käsuga.
UPDATE_CHECK=0

# Cloudflare R2. Täida ainult siis, kui STORAGE=r2.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=raadio
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Valikuline
# KUKU_STREAM_URL=
# KUKU_SCHEDULE_URL=
